# La Beauté Aldona Targiel — konfiguracja Apache na hostingu OVH.
#
# TO JEST SZABLON. Plik trafia do dist/ przy buildzie (scripts/build.mjs), a dwa tokeny w podwójnych
# podkreślnikach, DOMENA (domena strony bez www i bez protokołu) oraz DOMENA_RE (ta sama domena z kropkami
# zapisanymi dla wyrażeń regularnych), są podmieniane na domenę z deploy/targets.json (pole "site",
# jedyne miejsce z adresem strony). Nie wpisuj domeny tutaj na sztywno; zmiana domeny = zmiana jednego
# pola w targets.json. Build przerywa się, jeśli po podmianie w pliku zostanie jakikolwiek token.
#
# Wszystkie przekierowania mają pełny adres https://DOMENA/..., bo przy celu względnym Apache na OVH
# dokleja do nagłówka Location numer portu (:443). Strona jest jednojęzyczna: bez wyboru języka.

Options -Indexes
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 1. Jeden adres strony: https://__DOMENA__ (bez http, bez www i bez innych aliasów domeny) ---
  # Ścieżka i parametry zostają, np. http://www.__DOMENA__/cennik/ -> https://__DOMENA__/cennik/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^__DOMENA_RE__$ [NC]
  RewriteRule ^(.*)$ https://__DOMENA__/$1 [R=301,L]

  # --- 2. /index.html -> / ---
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ https://__DOMENA__/$1 [R=301,L]

  # --- 3. Katalog bez końcowego ukośnika -> z ukośnikiem (adresy kanoniczne kończą się "/") ---
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://__DOMENA__/$1/ [R=301,L]
</IfModule>

# --- Własna strona błędu 404 (odpowiedź ma kod 404) ---
ErrorDocument 404 /404.html

# --- Nagłówki bezpieczeństwa ---
# CSP: wszystko z własnego serwera; jedyny wyjątek to okno rezerwacji Booksy w <iframe> (frame-src).
# Strona nie wczytuje żadnych skryptów, stylów ani grafik Booksy: przyciski „Umów” otwierają własne
# okno (BookingModal) z iframe booksy.com/widget-2021. Formularz kontaktowy wysyła dane na własny serwer
# (connect-src 'self' dla fetch, form-action 'self'). Bez 'unsafe-inline': Astro buduje style
# i skrypty jako osobne pliki (inlineStylesheets: 'never', assetsInlineLimit: 0).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://booksy.com\")"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://booksy.com; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"

  # Zasoby z haszem w nazwie (katalog _astro): cache na rok
  <FilesMatch "\.(woff2|woff|css|js|webp|avif|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Ikony i obraz OG mają stałe nazwy: krótszy cache
  <FilesMatch "^(favicon.*|apple-touch-icon\.png|icon-(192|512)\.png|og\.png)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # HTML, sitemap, manifest, robots.txt: krótki cache (10 minut)
  <FilesMatch "\.(html|xml|webmanifest|txt)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
  # Formularz kontaktowy (PHP): nigdy z pamięci podręcznej
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# --- Kompresja ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml application/manifest+json
</IfModule>

# --- Pliki, które nie powinny być publiczne ---
<FilesMatch "^(README\.md|\.gitignore|\.gitattributes|package\.json|package-lock\.json)$">
  Require all denied
</FilesMatch>
