---
/**
 * Szablon każdej strony: <head> (SEO, OG, ikony, JSON-LD), link „przejdź do treści”,
 * jasny nagłówek, <main>, ciemny pas CTA (CtaBand, automatycznie na końcu <main>),
 * ciemna stopka i okno rezerwacji (BookingModal, montowane raz).
 *
 * Użycie (podstrona; rytm z briefu: jasny nagłówek → ciemny PageIntro → sekcje biel / kość
 * słoniowa na przemian → ciemny pas CTA → ciemna stopka):
 *   <Base title="Makijaż permanentny w Orzeszu" description="…" jsonLd={[serviceSchema({…})]}>
 *     <PageIntro eyebrow="…" title="…" lead="…" />          pierwszy element, zawiera <h1>
 *     <section class="section">…</section>                  biel
 *     <section class="section section--ivory">…</section>   kość słoniowa
 *   </Base>
 * `title` bez nazwy salonu: layout dopisze „ · La Beauté Orzesze”.
 * Na stronie głównej podaj pełny tytuł i `brandInTitle={false}`.
 * Pas CTA: `cta={{ title, text, eyebrow, buttonLabel }}` zmienia teksty, `cta={false}` go wyłącza.
 */
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-ext-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/latin-ext-500-italic.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-ext-600.css';
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-ext-300.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-ext-400.css';
import '@fontsource/jost/latin-500.css';
import '@fontsource/jost/latin-ext-500.css';
import '../styles/global.css';

import serifLatin from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import serifLatinExt from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-500-normal.woff2?url';
import sansLatin from '@fontsource/jost/files/jost-latin-300-normal.woff2?url';
import sansLatinExt from '@fontsource/jost/files/jost-latin-ext-300-normal.woff2?url';

import { site } from '../config/site';
import { websiteId } from '../lib/schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/BookingModal.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props {
  /** Tytuł strony (bez nazwy salonu, chyba że brandInTitle=false). */
  title: string;
  /** Meta description, ok. 120–160 znaków, z „Orzesze”. */
  description: string;
  /** Dopisz „ · La Beauté Orzesze” do <title>. Domyślnie true. */
  brandInTitle?: boolean;
  /** Dodatkowe węzły JSON-LD (np. beautySalonSchema(), serviceSchema()). */
  jsonLd?: Record<string, unknown>[];
  /** Strona wykluczona z indeksu (404): bez canonical i og:url. */
  noindex?: boolean;
  /** Obraz OG (ścieżka w public/). Domyślnie /og.png. */
  ogImage?: string;
  /** Ciemny pas CTA przed stopką: własne teksty albo false (bez pasa). Domyślnie teksty z CtaBand. */
  cta?: false | { eyebrow?: string; title?: string; text?: string; buttonLabel?: string; id?: string };
}

const { title, description, brandInTitle = true, jsonLd = [], noindex = false, ogImage = '/og.png', cta = {} } = Astro.props;

const fullTitle = brandInTitle ? `${title} · ${site.shortName} Orzesze` : title;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
const ogAlt = `${site.name}, salon kosmetyczny w Orzeszu`;
const preloadFonts = [serifLatin, serifLatinExt, sansLatin, sansLatinExt];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${site.url}/`,
      name: site.name,
      inLanguage: 'pl-PL',
    },
    ...jsonLd,
  ],
};
const safeJson = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={safeJson(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
      {cta !== false && <CtaBand {...cta} />}
    </main>
    <Footer />
    <BookingModal />
  </body>
</html>
