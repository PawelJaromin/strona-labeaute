---
/**
 * Zespół (dane z site.team, zdjęcia z src/assets/photos/personel-<key>.jpg).
 * Sam blok listy; nagłówek sekcji daje strona (SectionHead).
 *   <Team />            wszyscy
 *   <Team only={['aldona']} as="h4" />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config/site';
import aldona from '../assets/photos/personel-aldona.jpg';
import zaneta from '../assets/photos/personel-zaneta.jpg';
import wiktoria from '../assets/photos/personel-wiktoria.jpg';

interface Props {
  /** Klucze osób do pokazania (domyślnie wszyscy, w kolejności z site.team). */
  only?: string[];
  /** Poziom nagłówka z imieniem (domyślnie h3). */
  as?: 'h3' | 'h4';
}
const { only, as = 'h3' } = Astro.props;
const Tag = as;
const photos: Record<string, { src: ImageMetadata; alt: string }> = {
  aldona: { src: aldona, alt: 'Aldona Targiel, właścicielka salonu La Beauté, w białej marynarce' },
  zaneta: { src: zaneta, alt: 'Żaneta, stylistka paznokci w salonie La Beauté' },
  wiktoria: { src: wiktoria, alt: 'Wiktoria, stylistka paznokci w salonie La Beauté' },
};
const people = site.team.filter((p) => !only || only.includes(p.key));
---

<ul class="team" role="list">
  {
    people.map((p) => (
      <li class="team__person">
        <div class="team__photo">
          <Image
            src={photos[p.key].src}
            alt={photos[p.key].alt}
            widths={[240, 360, 480, 720]}
            sizes="(max-width: 640px) 112px, (max-width: 1000px) 30vw, 340px"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="team__text">
          <p class="team__role">{p.role}</p>
          <Tag class="team__name">{p.name}</Tag>
          <p class="team__spec">{p.specialties}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
  }
  .team__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--c-bg-2);
  }
  .team__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }
  .team__text {
    padding-top: 20px;
    margin-top: 20px;
    border-top: 1px solid var(--c-gold);
  }
  .team__role {
    margin: 0 0 6px;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }
  .team__name {
    margin: 0;
    font-size: clamp(1.75rem, 1.5rem + 0.8vw, 2.25rem);
  }
  .team__spec {
    margin: 8px 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--c-muted);
  }
  @media (max-width: 640px) {
    .team {
      grid-template-columns: 1fr;
      gap: 0;
      border-top: 1px solid var(--c-line);
    }
    .team__person {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 20px;
      align-items: center;
      padding: 18px 0;
      border-bottom: 1px solid var(--c-line);
    }
    .team__text {
      padding-top: 0;
      margin-top: 0;
      border-top: 0;
    }
  }
</style>
