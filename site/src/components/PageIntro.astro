---
/**
 * Ciemny pas wstępu podstrony (brief, sekcja 2 „Rytm stron”): tło #141414, złote hairline,
 * eyebrow w #D9BF86, h1 (maks. ok. 3,3 rem) i lead w #F6F2EA. Zawiera jedyny <h1> strony,
 * dlatego musi być PIERWSZYM elementem strony (pierwsza sekcja w <Base>); sprawdza to check:links.
 *
 *   <PageIntro
 *     eyebrow="Zabiegi · Makijaż permanentny"
 *     title="Makijaż permanentny"
 *     lead="…"
 *     image={photo} imageAlt="…"                     opcjonalne zdjęcie w złotej ramce (desktop: po prawej)
 *     primary={{ label: 'Umów wizytę', booksy: true }}
 *     secondary={{ label: 'Cennik zabiegu', href: '#cennik-zabiegu' }}
 *     note />                                        informacja „Rezerwacje online do 2 tygodni…”
 *
 *   <PageIntro compact eyebrow="Informacje" title="Polityka prywatności" lead="…" />   bez zdjęcia, niższy
 *
 * Kursywa w tytule: <Fragment slot="title">Makijaż <em>permanentny</em></Fragment>.
 * Domyślny slot: dodatkowa treść pod leadem (np. krótka lista faktów, <p class="muted small">).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import BookingNote from './BookingNote.astro';

interface Action {
  label: string;
  href?: string;
  /** true = ogólna rezerwacja przez widget Booksy (href ignorowany). */
  booksy?: boolean;
}
interface Props {
  eyebrow?: string;
  /** Tytuł h1 (albo slot "title"). */
  title?: string;
  lead?: string;
  image?: ImageMetadata;
  /** Wymagany, gdy podano `image`. */
  imageAlt?: string;
  /** Kadrowanie zdjęcia (object-position). */
  imagePosition?: 'center' | 'top' | 'bottom' | 'left' | 'right';
  /** Zdjęcie ładowane od razu (domyślnie tak: jest na pierwszym ekranie). */
  imageEager?: boolean;
  primary?: Action;
  secondary?: Action;
  /** Pokaż informację o rezerwacjach (2 tygodnie do przodu, telefon). */
  note?: boolean;
  /** Niższy pas bez zdjęcia (polityka prywatności, 404). */
  compact?: boolean;
  /** id nagłówka h1 (domyślnie "page-title"). */
  id?: string;
}

const {
  eyebrow,
  title,
  lead,
  image,
  imageAlt = '',
  imagePosition = 'center',
  imageEager = true,
  primary,
  secondary,
  note = false,
  compact = false,
  id = 'page-title',
} = Astro.props;
if (image && !imageAlt.trim()) throw new Error('PageIntro: podaj imageAlt dla zdjęcia.');
const hasTitleSlot = Astro.slots.has('title');
const hasMedia = Boolean(image) && !compact;
---

<section class:list={['section--dark', 'page-intro', { 'page-intro--media': hasMedia, 'page-intro--compact': compact }]} aria-labelledby={id}>
  <div class="container page-intro__in">
    <div class="page-intro__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 id={id} class="page-intro__title">{hasTitleSlot ? <slot name="title" /> : title}</h1>
      <span class="rule-gold page-intro__rule" aria-hidden="true"></span>
      {lead && <p class="lead page-intro__lead">{lead}</p>}
      {Astro.slots.has('default') && <div class="page-intro__extra"><slot /></div>}
      {
        (primary || secondary) && (
          <div class="btn-row page-intro__actions">
            {primary &&
              (primary.booksy ? (
                <Button booksy>{primary.label}</Button>
              ) : (
                <Button href={primary.href}>{primary.label}</Button>
              ))}
            {secondary &&
              (secondary.booksy ? (
                <Button booksy variant="secondary">
                  {secondary.label}
                </Button>
              ) : (
                <Button href={secondary.href} variant="secondary">
                  {secondary.label}
                </Button>
              ))}
          </div>
        )
      }
      {note && <BookingNote class="page-intro__note" />}
    </div>
    {
      hasMedia && image && (
        <div class="page-intro__media">
          <Image
            src={image}
            alt={imageAlt}
            widths={[400, 640, 880, 1100]}
            sizes="(max-width: 900px) calc(100vw - 40px), 520px"
            loading={imageEager ? 'eager' : 'lazy'}
            fetchpriority={imageEager ? 'high' : undefined}
            decoding="async"
            class={`pos-${imagePosition}`}
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-intro {
    position: relative;
    padding-block: clamp(56px, 6vw + 16px, 112px);
    border-bottom: 1px solid var(--c-gold);
  }
  .page-intro--compact {
    padding-block: clamp(48px, 4vw + 20px, 88px);
  }
  .page-intro__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }
  .page-intro--media .page-intro__in {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  .page-intro__copy {
    max-width: 680px;
  }
  .page-intro__title {
    margin: 0;
    font-size: clamp(2.25rem, 1.55rem + 2.6vw, 3.3rem);
    line-height: 1.06;
  }
  .page-intro__rule {
    margin-top: 28px;
  }
  .page-intro__lead {
    margin: 24px 0 0;
    max-width: 56ch;
  }
  .page-intro__extra {
    margin-top: 20px;
  }
  .page-intro__actions {
    margin-top: 36px;
  }
  .page-intro__copy :global(.page-intro__note) {
    margin: 18px 0 0;
  }
  .page-intro__media {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 560px;
    width: 100%;
    background: var(--c-dark-line);
  }
  .page-intro__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .page-intro__media :global(.pos-top) {
    object-position: 50% 15%;
  }
  .page-intro__media :global(.pos-bottom) {
    object-position: 50% 85%;
  }
  .page-intro__media :global(.pos-left) {
    object-position: 20% 50%;
  }
  .page-intro__media :global(.pos-right) {
    object-position: 80% 50%;
  }
  /* Złota ramka wewnątrz zdjęcia (jak w hero strony głównej) */
  .page-intro__media::after {
    content: '';
    position: absolute;
    inset: clamp(12px, 1.4vw, 20px);
    border: 1px solid rgba(184, 146, 63, 0.9);
    pointer-events: none;
  }
  @media (max-width: 900px) {
    .page-intro--media .page-intro__in {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .page-intro__media {
      aspect-ratio: 3 / 2;
      max-height: none;
    }
  }
  @media (max-width: 480px) {
    .page-intro__actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
