---
/**
 * Duży wiersz edytorialny zabiegu: zdjęcie + numer/eyebrow, nagłówek, tekst, wybrane ceny, link.
 * Kolejne wiersze naprzemiennie (reverse) dają rytm bez siatki kart.
 *
 *   <ServiceFeature index="01" eyebrow="Brwi · usta · linia rzęs" title="Makijaż permanentny"
 *     text="…" image={photo} imageAlt="…" href="/makijaz-permanentny/" linkLabel="Poznaj zabieg"
 *     highlights={[{ label: 'Brwi', value: '900 zł' }]} reverse />
 * Zamiast `text` można podać treść w slocie (akapity <p>).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../lib/url';

interface Highlight {
  label: string;
  value: string;
}
interface Props {
  /** Numer porządkowy, np. "01". */
  index?: string;
  eyebrow?: string;
  title: string;
  text?: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Kadrowanie zdjęcia (object-position). */
  imagePosition?: 'center' | 'top' | 'bottom' | 'left' | 'right';
  href?: string;
  linkLabel?: string;
  /** Drugi link pod wierszem: kotwica do cennika zabiegu (np. "/makijaz-permanentny/#cennik-zabiegu"). */
  priceHref?: string;
  priceLabel?: string;
  /** Kilka pozycji „jak w karcie menu”: nazwa i cena. */
  highlights?: Highlight[];
  /** Zdjęcie po prawej zamiast po lewej. */
  reverse?: boolean;
  as?: 'h2' | 'h3';
  id?: string;
}

const {
  index,
  eyebrow,
  title,
  text,
  image,
  imageAlt,
  imagePosition = 'center',
  href,
  linkLabel = 'Poznaj zabieg',
  priceHref,
  priceLabel = 'Cennik zabiegu',
  highlights = [],
  reverse = false,
  as = 'h3',
  id,
} = Astro.props;
const Tag = as;
// Adresy wewnętrzne z podścieżką (kopia tymczasowa); zewnętrzne zostają bez zmian.
const linkHref = href && withBase(href);
const priceLinkHref = priceHref && withBase(priceHref);
---

<article class:list={['sf', { 'sf--reverse': reverse }]} id={id}>
  <div class="sf__media">
    <Image
      src={image}
      alt={imageAlt}
      widths={[400, 640, 880, 1100]}
      sizes="(max-width: 900px) calc(100vw - 40px), 520px"
      loading="lazy"
      decoding="async"
      class={`pos-${imagePosition}`}
    />
  </div>
  <div class="sf__body">
    {
      (index || eyebrow) && (
        <p class="sf__eyebrow">
          {index && <span class="sf__index">{index}</span>}
          {eyebrow && <span>{eyebrow}</span>}
        </p>
      )
    }
    <Tag class="sf__title">{title}</Tag>
    {text && <p class="sf__text">{text}</p>}
    <div class="sf__slot"><slot /></div>
    {
      highlights.length > 0 && (
        <dl class="sf__list">
          {highlights.map((h) => (
            <div>
              <dt>{h.label}</dt>
              <dd>{h.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    {
      (href || priceHref) && (
        <div class="sf__links">
          {href && (
            <a class="link-arrow" href={linkHref}>
              {linkLabel}
              <span class="visually-hidden">: {title}</span>
            </a>
          )}
          {priceHref && (
            <a class="link-arrow" href={priceLinkHref}>
              {priceLabel}
              <span class="visually-hidden">: {title}</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .sf {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(32px, 7vw, 112px);
    align-items: center;
  }
  .sf--reverse {
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
  }
  .sf--reverse .sf__media {
    order: 2;
  }
  .sf__media {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 720px;
    width: 100%;
    background: var(--c-bg-2);
  }
  /* Złota ramka przesunięta za zdjęciem (passe-partout) */
  .sf__media::before {
    content: '';
    position: absolute;
    inset: 18px -18px -18px 18px;
    border: 1px solid var(--c-gold);
    pointer-events: none;
  }
  .sf--reverse .sf__media::before {
    inset: 18px 18px -18px -18px;
  }
  .sf__media :global(img) {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sf__media :global(.pos-top) {
    object-position: 50% 15%;
  }
  .sf__media :global(.pos-bottom) {
    object-position: 50% 85%;
  }
  .sf__media :global(.pos-left) {
    object-position: 20% 50%;
  }
  .sf__media :global(.pos-right) {
    object-position: 80% 50%;
  }
  .sf__body {
    max-width: 500px;
  }
  .sf__eyebrow {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: 0 0 20px;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }
  .sf__index {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    padding-right: 16px;
    border-right: 1px solid var(--c-gold);
  }
  .sf__title {
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.125rem);
    line-height: 1.06;
  }
  .sf__text {
    margin: 22px 0 0;
    color: var(--c-ink);
  }
  .sf__slot:empty {
    display: none;
  }
  .sf__slot {
    margin-top: 16px;
  }
  .sf__list {
    margin: 30px 0 0;
    border-top: 1px solid var(--c-line);
  }
  .sf__list div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px solid var(--c-line);
  }
  .sf__list dt {
    font-size: 0.9375rem;
  }
  .sf__list dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }
  .sf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 36px;
    margin-top: 26px;
  }
  @media (max-width: 900px) {
    .sf,
    .sf--reverse {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .sf--reverse .sf__media {
      order: 0;
    }
    .sf__media {
      aspect-ratio: 4 / 3;
      width: calc(100% - 14px);
    }
    .sf__media::before,
    .sf--reverse .sf__media::before {
      inset: 14px -14px -14px 14px;
    }
    .sf__body {
      max-width: 620px;
    }
  }
</style>
