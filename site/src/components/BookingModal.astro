---
/**
 * Okno rezerwacji (montowane raz w layouts/Base.astro). Obsługuje dwa rodzaje linków:
 *
 * 1) a[data-booking]: rezerwacja konkretnej usługi. Link ma href = bookingUrl(variantId)
 *    (okno Booksy „widget-2021” z variantId) i otwiera się tu w <dialog> z <iframe>.
 *    Zamykanie: przycisk, Esc, kliknięcie w tło; blokada przewijania tła; fokus wraca na link.
 *    Bez JS: zwykły link w nowej karcie (target="_blank" rel="noopener").
 *    Najprościej: <Button href={bookingUrl(id)} booking="Nazwa usługi" size="sm">Umów</Button>
 *
 * 2) a[data-booksy]: ogólny przycisk „Umów wizytę”. Ładuje oficjalny skrypt Booksy
 *    (booksy.com/widget/code.js, tryb dialog) dopiero, gdy ktoś wskaże lub kliknie przycisk,
 *    i otwiera jego okno. Gdy skrypt się nie wczyta: przejście do profilu salonu w Booksy.
 *    Najprościej: <Button booksy>Umów wizytę</Button>
 */
import { site } from '../config/site';
---

<dialog class="bm" id="booking-modal" aria-labelledby="bm-title" data-widget-script={site.booksy.widgetScript}>
  <div class="bm__bar">
    <p class="bm__title" id="bm-title">
      <span class="bm__eyebrow">Rezerwacja online</span>
      <span class="bm__service" data-bm-service></span>
    </p>
    <a class="bm__ext" href={site.booksy.linkUrl} target="_blank" rel="noopener" data-bm-ext>
      Otwórz w nowej karcie
    </a>
    <button class="bm__close" type="button" data-bm-close aria-label="Zamknij okno rezerwacji">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.2"></path></svg>
    </button>
  </div>
  <div class="bm__frame">
    <iframe title="Rezerwacja wizyty w serwisie Booksy" data-bm-frame></iframe>
    <p class="bm__loading" aria-hidden="true">Ładowanie okna rezerwacji…</p>
  </div>
  <p class="bm__note">
    Rezerwacje online do {site.booksy.bookingWindowWeeks} tygodni do przodu; w innym terminie zadzwoń:
    <a href={site.phone.href}>{site.phone.display}</a>.
  </p>
</dialog>

<!-- Miejsce na oficjalny widget Booksy (jego własny przycisk jest ukryty; uruchamiają go nasze przyciski data-booksy). -->
<div id="booksy-host" hidden></div>

<style>
  .bm {
    width: min(860px, calc(100vw - 32px));
    height: min(820px, calc(100dvh - 32px));
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid var(--c-line);
    border-radius: 0;
    background: var(--c-bg);
    color: var(--c-ink);
    overflow: hidden;
  }
  .bm[open] {
    display: flex;
    flex-direction: column;
  }
  .bm::backdrop {
    background: rgba(22, 22, 22, 0.55);
  }
  .bm__bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 10px 10px 24px;
    border-bottom: 1px solid var(--c-gold);
    flex: none;
  }
  .bm__title {
    flex: 1;
    min-width: 0;
    margin: 0;
    display: grid;
    line-height: 1.25;
  }
  .bm__eyebrow {
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }
  .bm__service {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bm__service:empty {
    display: none;
  }
  .bm__ext {
    flex: none;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--c-muted);
  }
  .bm__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid transparent;
    background: transparent;
    color: var(--c-ink);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }
  .bm__close:hover {
    border-color: var(--c-gold);
  }
  .bm__frame {
    position: relative;
    flex: 1;
    min-height: 0;
    background: var(--c-bg);
  }
  .bm__frame iframe {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
  }
  .bm__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-size: 0.875rem;
    color: var(--c-muted);
  }
  .bm__note {
    flex: none;
    margin: 0;
    padding: 10px 24px;
    border-top: 1px solid var(--c-line);
    background: var(--c-bg-2);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--c-muted);
  }
  .bm__note a {
    color: var(--c-ink);
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .bm {
      width: 100vw;
      height: 100dvh;
      border: 0;
    }
    .bm__bar {
      padding-left: 16px;
      gap: 10px;
    }
    .bm__ext {
      display: none;
    }
    .bm__note {
      padding: 8px 16px;
    }
  }
</style>

<script>
  const dlg = document.getElementById('booking-modal') as HTMLDialogElement | null;
  const frame = dlg?.querySelector<HTMLIFrameElement>('[data-bm-frame]') ?? null;
  const serviceEl = dlg?.querySelector<HTMLElement>('[data-bm-service]') ?? null;
  const extLink = dlg?.querySelector<HTMLAnchorElement>('[data-bm-ext]') ?? null;
  const closeBtn = dlg?.querySelector<HTMLButtonElement>('[data-bm-close]') ?? null;
  const BOOKSY_ORIGIN = 'https://booksy.com';
  const MODAL_UID = 'labeaute-booking';
  let lastTrigger: HTMLElement | null = null;

  const setLocked = (on: boolean) => document.documentElement.classList.toggle('is-locked', on);
  const modifiedClick = (e: MouseEvent) => e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey;

  /* ------------------------------------------------ 1) okno usługi (dialog + iframe) */
  function openBooking(url: string, title: string, trigger: HTMLElement | null) {
    if (!dlg || !frame || typeof dlg.showModal !== 'function') {
      window.open(url, '_blank', 'noopener');
      return;
    }
    lastTrigger = trigger;
    if (serviceEl) serviceEl.textContent = title;
    if (extLink) extLink.href = url;
    let src = url;
    try {
      const u = new URL(url);
      u.searchParams.set('uniqueId', MODAL_UID);
      src = u.href;
    } catch {
      /* zostaje oryginalny adres */
    }
    frame.src = src;
    dlg.showModal();
    setLocked(true);
    closeBtn?.focus();
  }

  dlg?.addEventListener('close', () => {
    if (frame) frame.src = 'about:blank';
    setLocked(false);
    lastTrigger?.focus();
    lastTrigger = null;
  });
  closeBtn?.addEventListener('click', () => dlg?.close());
  // Kliknięcie w przyciemnione tło (poza oknem) zamyka okno.
  dlg?.addEventListener('click', (e) => {
    if (e.target !== dlg) return;
    const r = dlg.getBoundingClientRect();
    const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
    if (!inside) dlg.close();
  });
  // Okno Booksy może samo poprosić o zamknięcie (przycisk „zamknij” w widgecie).
  window.addEventListener('message', (e) => {
    if (e.origin !== BOOKSY_ORIGIN || !dlg?.open) return;
    const d = e.data as { uniqueId?: string; events?: Record<string, unknown> } | null;
    if (d && d.uniqueId === MODAL_UID && d.events && 'close' in d.events) dlg.close();
  });

  /* ------------------------------------------------ 2) oficjalny widget Booksy */
  const host = document.getElementById('booksy-host');
  const scriptUrl = dlg?.dataset.widgetScript ?? '';
  let widgetPromise: Promise<HTMLElement | null> | null = null;

  function loadWidget(): Promise<HTMLElement | null> {
    if (widgetPromise) return widgetPromise;
    widgetPromise = new Promise((resolve) => {
      if (!host || !scriptUrl) return resolve(null);
      const find = () => host.querySelector<HTMLElement>('.booksy-widget-button');
      const timer = window.setTimeout(() => resolve(find()), 6000);
      const s = document.createElement('script');
      s.src = scriptUrl;
      s.async = true;
      s.onload = () => {
        window.clearTimeout(timer);
        resolve(find());
      };
      s.onerror = () => {
        window.clearTimeout(timer);
        resolve(null);
      };
      host.appendChild(s);
    });
    return widgetPromise;
  }

  function watchBooksyDialog(trigger: HTMLElement, scrollY: number) {
    const dialogs = document.querySelectorAll<HTMLElement>('body > .booksy-widget-dialog');
    const box = dialogs[dialogs.length - 1];
    const overlays = document.querySelectorAll<HTMLElement>('body > .booksy-widget-overlay');
    const overlay = overlays[overlays.length - 1];
    // Skrypt Booksy przewija stronę do góry; okno jest przypięte w CSS, więc wracamy na miejsce.
    window.scrollTo({ top: scrollY, behavior: 'instant' as ScrollBehavior });
    if (!box) return;
    setLocked(true);
    box.setAttribute('role', 'dialog');
    box.setAttribute('aria-modal', 'true');
    box.setAttribute('aria-label', 'Rezerwacja wizyty w serwisie Booksy');
    const iframe = box.querySelector('iframe');
    if (iframe) iframe.title = 'Rezerwacja wizyty w serwisie Booksy';

    const close = () => {
      box.remove();
      overlay?.remove();
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
    };
    document.addEventListener('keydown', onKey);
    overlay?.addEventListener('click', close);
    const obs = new MutationObserver(() => {
      if (!box.isConnected) {
        obs.disconnect();
        document.removeEventListener('keydown', onKey);
        overlay?.remove();
        setLocked(false);
        trigger.focus();
      }
    });
    obs.observe(document.body, { childList: true });
    // Fokus na oknie (nie w iframe): wtedy Esc trafia do tej strony i zamyka okno.
    // Po kliknięciu w treść Booksy klawisze obsługuje już iframe; zamyka je wtedy „X” Booksy.
    box.tabIndex = -1;
    window.setTimeout(() => box.focus({ preventScroll: true }), 50);
  }

  async function openWidget(trigger: HTMLAnchorElement) {
    trigger.setAttribute('aria-busy', 'true');
    const button = await loadWidget();
    trigger.removeAttribute('aria-busy');
    if (!button) {
      // Widget niedostępny (blokada, brak sieci): profil salonu w Booksy.
      window.location.assign(trigger.href);
      return;
    }
    const y = window.scrollY;
    button.click();
    watchBooksyDialog(trigger, y);
  }

  // Wczytaj skrypt Booksy z wyprzedzeniem, gdy ktoś wskaże przycisk lub przejdzie do niego klawiaturą.
  const prefetch = (e: Event) => {
    const t = e.target as Element | null;
    if (t && typeof t.closest === 'function' && t.closest('a[data-booksy]')) void loadWidget();
  };
  document.addEventListener('pointerover', prefetch, { passive: true });
  document.addEventListener('focusin', prefetch);
  document.addEventListener('touchstart', prefetch, { passive: true });

  /* ------------------------------------------------ delegacja kliknięć */
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || modifiedClick(e)) return;
    const target = e.target as Element | null;
    if (!target || typeof target.closest !== 'function') return;
    const booking = target.closest<HTMLAnchorElement>('a[data-booking]');
    if (booking) {
      e.preventDefault();
      openBooking(booking.href, booking.dataset.bookingTitle ?? '', booking);
      return;
    }
    const booksy = target.closest<HTMLAnchorElement>('a[data-booksy]');
    if (booksy) {
      e.preventDefault();
      void openWidget(booksy);
    }
  });
</script>
