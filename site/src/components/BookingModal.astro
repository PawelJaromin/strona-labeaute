---
/**
 * Okno rezerwacji (montowane raz w layouts/Base.astro): <dialog> na wysokość ekranu z <iframe>
 * okna Booksy „widget-2021”. Iframe ma stałą wysokość okna, a treść Booksy przewija się w nim,
 * więc komunikaty Booksy (np. „Brak wolnych terminów”) są zawsze na ekranie. Obsługuje dwa rodzaje linków:
 *
 * 1) a[data-booking]: rezerwacja konkretnej usługi. href = bookingUrl(variantId), tytuł z data-booking-title.
 *    Najprościej: <Button href={bookingUrl(id)} booking="Nazwa usługi" size="sm">Umów</Button>
 *
 * 2) a[data-booksy]: ogólny przycisk „Umów wizytę” (nagłówek, hero, wstęp podstron, pas CTA, kontakt).
 *    Otwiera to samo okno z adresem site.booksy.widgetBase (wszystkie usługi salonu, bez variantId),
 *    tytuł „Rezerwacja online · La Beauté”. href linku to profil salonu w Booksy (bez JS: nowa karta).
 *    Najprościej: <Button booksy>Umów wizytę</Button>
 *
 * Oficjalnego skryptu Booksy (booksy.com/widget/code.js) celowo nie używamy: jego okno rozciągało
 * iframe do pełnej wysokości treści (8–10 tys. px), więc komunikaty Booksy lądowały daleko pod ekranem.
 *
 * Zamykanie: przycisk, Esc, kliknięcie w tło, prośba okna Booksy (postMessage „close”). Blokada
 * przewijania tła (html.is-locked), fokus na przycisku zamknięcia, po zamknięciu wraca na link.
 * Bez JS albo bez obsługi <dialog>: zwykły link w nowej karcie (target="_blank" rel="noopener").
 */
import { site } from '../config/site';
---

<dialog
  class="bm"
  id="booking-modal"
  aria-labelledby="bm-title"
  data-general-url={site.booksy.widgetBase}
  data-general-title={site.shortName}
>
  <div class="bm__bar">
    <p class="bm__title" id="bm-title">
      <span class="bm__eyebrow">Rezerwacja online</span><span class="visually-hidden"> · </span><span
        class="bm__service"
        data-bm-service></span>
    </p>
    <a class="bm__ext" href={site.booksy.linkUrl} target="_blank" rel="noopener" data-bm-ext>
      Otwórz w nowej karcie
    </a>
    <button class="bm__close" type="button" data-bm-close aria-label="Zamknij okno rezerwacji">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.2"></path></svg>
    </button>
  </div>
  <div class="bm__frame">
    <iframe title="Rezerwacja wizyty w serwisie Booksy" data-bm-frame></iframe>
    <p class="bm__loading" aria-hidden="true">Ładowanie okna rezerwacji…</p>
  </div>
  <p class="bm__note">
    Rezerwacje online do {site.booksy.bookingWindowWeeks} tygodni do przodu; w innym terminie zadzwoń:
    <a href={site.phone.href}>{site.phone.display}</a>.
  </p>
</dialog>

<style>
  /* Okno zajmuje wysokość ekranu (bez 16 px marginesu z każdej strony), iframe resztę okna. */
  .bm {
    width: min(860px, calc(100vw - 32px));
    height: min(960px, calc(100dvh - 32px));
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid var(--c-line);
    border-radius: 0;
    background: var(--c-bg);
    color: var(--c-ink);
    overflow: hidden;
    overscroll-behavior: contain;
  }
  .bm[open] {
    display: flex;
    flex-direction: column;
  }
  .bm::backdrop {
    background: rgba(22, 22, 22, 0.55);
  }
  .bm__bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 10px 10px 24px;
    border-bottom: 1px solid var(--c-gold);
    flex: none;
  }
  .bm__title {
    flex: 1;
    min-width: 0;
    margin: 0;
    display: grid;
    line-height: 1.25;
  }
  .bm__eyebrow {
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-gold-ink);
  }
  .bm__service {
    min-width: 0;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bm__service:empty {
    display: none;
  }
  .bm__ext {
    flex: none;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--c-muted);
  }
  .bm__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid transparent;
    background: transparent;
    color: var(--c-ink);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }
  .bm__close:hover {
    border-color: var(--c-gold);
  }
  .bm__frame {
    position: relative;
    flex: 1;
    min-height: 0;
    background: var(--c-bg);
  }
  .bm__frame iframe {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
  }
  .bm__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-size: 0.875rem;
    color: var(--c-muted);
  }
  .bm__note {
    flex: none;
    margin: 0;
    padding: 10px 24px;
    border-top: 1px solid var(--c-line);
    background: var(--c-bg-2);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--c-muted);
  }
  .bm__note a {
    color: var(--c-ink);
    white-space: nowrap;
  }
  /* Telefon w pionie: pełny ekran. */
  @media (max-width: 600px) {
    .bm {
      width: 100vw;
      height: 100dvh;
      border: 0;
    }
    .bm__bar {
      padding-left: 16px;
      gap: 10px;
    }
    .bm__ext {
      display: none;
    }
    .bm__note {
      padding: 8px 16px;
    }
  }
  /* Niski ekran (telefon w poziomie): pełny ekran, niższy pasek tytułu i jednowierszowa informacja,
     żeby iframe Booksy dostał jak najwięcej wysokości. */
  @media (max-height: 500px) {
    .bm {
      width: 100vw;
      height: 100dvh;
      border: 0;
    }
    .bm__bar {
      padding: 3px 8px 3px 16px;
      gap: 12px;
    }
    .bm__title {
      display: flex;
      align-items: baseline;
      gap: 12px;
    }
    .bm__eyebrow {
      flex: none;
    }
    .bm__service {
      flex: 1;
      font-size: 1.125rem;
    }
    .bm__note {
      padding: 5px 16px;
      font-size: 0.75rem;
      line-height: 1.4;
    }
  }
</style>

<script>
  const dlg = document.getElementById('booking-modal') as HTMLDialogElement | null;
  const frame = dlg?.querySelector<HTMLIFrameElement>('[data-bm-frame]') ?? null;
  const serviceEl = dlg?.querySelector<HTMLElement>('[data-bm-service]') ?? null;
  const extLink = dlg?.querySelector<HTMLAnchorElement>('[data-bm-ext]') ?? null;
  const closeBtn = dlg?.querySelector<HTMLButtonElement>('[data-bm-close]') ?? null;
  const generalUrl = dlg?.dataset.generalUrl ?? '';
  const generalTitle = dlg?.dataset.generalTitle ?? '';
  const BOOKSY_ORIGIN = 'https://booksy.com';
  const MODAL_UID = 'labeaute-booking';
  const LINKS = 'a[data-booking], a[data-booksy]';
  // Bez <dialog> (bardzo stare przeglądarki) linki działają zwyczajnie: nowa karta z Booksy.
  const canOpen = Boolean(dlg && frame && typeof dlg.showModal === 'function');
  let lastTrigger: HTMLElement | null = null;

  const setLocked = (on: boolean) => document.documentElement.classList.toggle('is-locked', on);
  const modifiedClick = (e: MouseEvent) => e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey;

  function openBooking(url: string, title: string, trigger: HTMLElement | null) {
    if (!dlg || !frame) return;
    lastTrigger = trigger;
    if (serviceEl) serviceEl.textContent = title;
    if (extLink) extLink.href = url;
    let src = url;
    try {
      const u = new URL(url);
      u.searchParams.set('uniqueId', MODAL_UID);
      src = u.href;
    } catch {
      /* zostaje oryginalny adres */
    }
    frame.src = src;
    dlg.showModal();
    setLocked(true);
    closeBtn?.focus();
  }

  if (canOpen && dlg) {
    // Z JS linki rezerwacji otwierają okno na tej stronie, a nie nową kartę: mówimy o tym czytnikom ekranu.
    document.querySelectorAll<HTMLAnchorElement>(LINKS).forEach((a) => a.setAttribute('aria-haspopup', 'dialog'));

    dlg.addEventListener('close', () => {
      if (frame) frame.src = 'about:blank';
      setLocked(false);
      lastTrigger?.focus({ preventScroll: true });
      lastTrigger = null;
    });
    closeBtn?.addEventListener('click', () => dlg.close());
    // Kliknięcie w przyciemnione tło (poza oknem) zamyka okno.
    dlg.addEventListener('click', (e) => {
      if (e.target !== dlg) return;
      const r = dlg.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) dlg.close();
    });
    // Okno Booksy może samo poprosić o zamknięcie (przycisk „zamknij” w widgecie).
    window.addEventListener('message', (e) => {
      if (e.origin !== BOOKSY_ORIGIN || !dlg.open) return;
      const d = e.data as { uniqueId?: string; events?: Record<string, unknown> } | null;
      if (d && d.uniqueId === MODAL_UID && d.events && 'close' in d.events) dlg.close();
    });

    // Delegacja kliknięć: „Umów” przy usłudze (data-booking) i ogólne „Umów wizytę” (data-booksy).
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || modifiedClick(e)) return;
      const target = e.target as Element | null;
      if (!target || typeof target.closest !== 'function') return;
      const link = target.closest<HTMLAnchorElement>(LINKS);
      if (!link) return;
      const general = link.hasAttribute('data-booksy');
      const url = general ? generalUrl : link.href;
      if (!url) return; // brak adresu okna: zwykły link (nowa karta)
      e.preventDefault();
      openBooking(url, general ? generalTitle : (link.dataset.bookingTitle ?? ''), link);
    });
  }
</script>
